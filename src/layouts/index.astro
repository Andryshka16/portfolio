---
import Analytics from '@vercel/analytics/astro'
import '../styles/index.css'

const CONFIG = {
    title: 'Andrey Lapchik — Full-Stack Developer | React, TypeScript, Node.js',
    description:
        'Full-stack developer in Riga building high-performance, real-time web applications. React, TypeScript, Node.js, NestJS, PixiJS, WebSockets.',
    url: 'https://andryshka.com',
    image: '/preview.png',
    author: 'Andrey Lapchik',
    keywords: [
        'full-stack developer',
        'frontend engineer',
        'React developer',
        'Next.js developer',
        'Node.js developer',
        'TypeScript developer',
        'NestJS',
        'PixiJS',
        'WebGL',
        'WebSockets',
        'real-time systems',
        'iGaming developer',
        'live casino frontend',
        'web developer Latvia',
        'Riga developer'
    ].join(', '),
    locale: 'en_US',
    type: 'website'
}

const PROFILE_SCHEMA = {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    dateModified: new Date().toISOString().slice(0, 10),
    mainEntity: {
        '@type': 'Person',
        '@id': `${CONFIG.url}/#person`,
        name: 'Andrey Lapchik',
        url: CONFIG.url,
        image: `${CONFIG.url}/me.webp`,
        jobTitle: 'Full-Stack Developer',
        description: CONFIG.description,
        email: 'mailto:contact@andryshka.com',
        telephone: '+371-28176717',
        address: {
            '@type': 'PostalAddress',
            addressLocality: 'Riga',
            addressCountry: 'LV'
        },
        worksFor: {
            '@type': 'Organization',
            name: 'Proxy Live Solutions'
        },
        alumniOf: {
            '@type': 'CollegeOrUniversity',
            name: 'University of Latvia'
        },
        knowsAbout: [
            'React',
            'Next.js',
            'TypeScript',
            'Node.js',
            'NestJS',
            'PixiJS',
            'WebGL',
            'HTML5 Canvas',
            'WebSockets',
            'Protobuf',
            'PostgreSQL',
            'Redis',
            'Docker',
            'Real-time systems',
            'Low-latency streaming',
            'Frontend performance optimisation',
            'iGaming',
            'Live casino game clients'
        ],
        knowsLanguage: ['ru', 'en', 'lv'],
        sameAs: ['https://www.linkedin.com/in/andryshka', 'https://github.com/Andryshka16']
    }
}
---

<!doctype html>
<html lang='en' class='dark'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1' />
        <meta name='generator' content={Astro.generator} />

        <!-- Primary Meta Tags -->
        <title>{CONFIG.title}</title>
        <meta name='title' content={CONFIG.title} />
        <meta name='description' content={CONFIG.description} />
        <meta name='keywords' content={CONFIG.keywords} />
        <meta name='author' content={CONFIG.author} />
        <meta
            name='robots'
            content='index, follow, max-image-preview:large, max-snippet:220, max-video-preview:-1'
        />
        <meta name='googlebot' content='index, follow, max-snippet:220' />
        <meta name='bingbot' content='index, follow' />

        <!-- Language and Locale -->
        <meta name='language' content='English' />
        <meta name='geo.region' content='LV' />
        <meta name='geo.placename' content='Riga' />
        <meta name='geo.position' content='56.9496;24.1052' />
        <meta name='ICBM' content='56.9496, 24.1052' />

        <!-- Canonical URL -->
        <link rel='canonical' href={CONFIG.url} />

        <!-- Favicon and Icons -->
        <link rel='icon' type='image/png' href='/favicon.png' />
        <link rel='apple-touch-icon' href='/favicon.png' />
        <link rel='manifest' href='/meta/manifest.json' />

        <!-- Open Graph / Facebook -->
        <meta property='og:type' content={CONFIG.type} />
        <meta property='og:url' content={CONFIG.url} />
        <meta property='og:title' content={CONFIG.title} />
        <meta property='og:description' content={CONFIG.description} />
        <meta property='og:image' content={`${CONFIG.url}${CONFIG.image}`} />
        <meta property='og:image:width' content='1200' />
        <meta property='og:image:height' content='630' />
        <meta property='og:image:alt' content='Andrey Lapchik - Full-Stack Developer Portfolio' />
        <meta property='og:site_name' content='Andrey Lapchik Portfolio' />
        <meta property='og:locale' content={CONFIG.locale} />

        <!-- Twitter -->
        <meta name='twitter:card' content='summary_large_image' />
        <meta name='twitter:url' content={CONFIG.url} />
        <meta name='twitter:title' content={CONFIG.title} />
        <meta name='twitter:description' content={CONFIG.description} />
        <meta name='twitter:image' content={`${CONFIG.url}${CONFIG.image}`} />
        <meta name='twitter:image:alt' content='Andrey Lapchik - Full-Stack Developer Portfolio' />
        <meta name='twitter:creator' content='@andryshka16' />
        <meta name='twitter:site' content='@andryshka16' />

        <!-- Additional Meta Tags -->
        <meta name='theme-color' content='#0D0D0D' />
        <meta name='color-scheme' content='dark' />
        <meta name='msapplication-TileColor' content='#0D0D0D' />
        <meta name='msapplication-config' content='/meta/browserconfig.xml' />

        <!-- Preconnect to external domains -->
        <link rel='preconnect' href='https://fonts.googleapis.com' />
        <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />

        <!-- Font Preloading -->
        <link
            rel='preload'
            href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap'
            as='style'
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript
            ><link
                rel='stylesheet'
                href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap'
            /></noscript
        >

        <!-- Preload critical images -->
        <link rel='preload' as='image' href='/me.webp' />

        <!-- Additional SEO -->
        <meta name='format-detection' content='telephone=yes' />
        <meta name='mobile-web-app-capable' content='yes' />
        <meta name='apple-mobile-web-app-capable' content='yes' />
        <meta name='apple-mobile-web-app-status-bar-style' content='black-translucent' />
        <meta name='apple-mobile-web-app-title' content='Andrey Lapchik' />

        <!-- Structured Data: ProfilePage -->
        <script type='application/ld+json' set:html={JSON.stringify(PROFILE_SCHEMA)} is:inline />
    </head>
    <body class='bg-gray-900 text-gray-100 antialiased'>
        <slot />
        <Analytics />
    </body>
</html>
